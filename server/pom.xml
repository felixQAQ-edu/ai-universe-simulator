<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.aiuniverse</groupId>
	<artifactId>server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>server</name>
	<description>AI Universe Simulator backend (Phase 1 skeleton)</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!--
		  部署身份:构建时由 -Dgit.sha=<sha> 注入,进 build-info.properties → /actuator/info。
		  缺省 unknown 是刻意的:Docker 多阶段构建拿不到 .git(.dockerignore 排除),
		  故 SHA 只能靠构建参数传;没传就显示 unknown —— 那本身就是「这次部署没走文档里那条命令」
		  的可见信号,好过静默显示一个假值(见 runbook §3.1.5)。
		-->
		<git.sha>unknown</git.sha>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- 平台探针(ADR-015 已知代价 6 收账,Slice 3):只开 health,其余端点一律不暴露(application.yml) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<!--
					  build-info:生成 META-INF/build-info.properties(版本 + 构建时间 + 下面这个 commit),
					  由 actuator 的 info 端点原样吐出。存在理由=让「线上跑的是哪个 commit」
					  变成一条 curl 能回答的问题 —— 这个坑已摔过两次(runbook §3.1.5 靠比对 bundle 哈希、
					  §3.1.6 靠翻启动日志才取证)。纯构建期元数据,不进任何业务路径。
					-->
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
						<configuration>
							<additionalProperties>
								<commit>${git.sha}</commit>
							</additionalProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
